{
  "name": "@loonglab/loongcode-cli",
  "version": "0.1.4",
  "description": "LoongCode — a terminal coding agent that works directly in your repository",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoongLab/LoongCode.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/LoongLab/LoongCode/issues"
  },
  "type": "module",
  "bin": {
    "loongcode": "dist/loongcode.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepack": "cd ../.. && bun run build:cli && cp CHANGELOG.md packages/cli/CHANGELOG.md && cp LICENSE packages/cli/LICENSE && cp NOTICE packages/cli/NOTICE && cp THIRD_PARTY_NOTICES.md packages/cli/THIRD_PARTY_NOTICES.md"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.58",
    "@ai-sdk/openai": "4.0.71",
    "@loongcode/agent": "workspace:*",
    "@loongcode/model": "workspace:*",
    "@loongcode/tui": "workspace:*",
    "ai": "7.0.107",
    "diff": "9.0.0",
    "get-east-asian-width": "1.6.0",
    "marked": "18.0.11",
    "zod": "4.6.5"
  }
}
